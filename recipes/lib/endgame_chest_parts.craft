# Building blocks for the Sanavixx "Endgame Chest" (Astral Plate, Hunter + Warlord),
# adjusted to how the project owner actually crafts it (2026-11-18):
#   * "Suffixes Cannot Be Changed" on a rare = bench craft (4 div + 4 blessed); the
#     metamod beastcraft only works on magic items.
#   * ONE locked Caster reforge; then 2 open prefixes -> Foulborn exalt + bench armour,
#     1 open -> bench armour, full -> keep the item (annulling is too risky).
#   * Hinekora previews on the Awakener are used to farm a good third suffix
#     (T1-T2 elemental/chaos resistance) with an open prefix for the lock.
include "elevate.craft"

# Step 1: Warlord piece -> magic Astral Plate with ONLY the elevated mana-cost suffix
# (magic is needed for Hinekora's Lock). Set aside as `warlord`.
def warlord_piece() {
    buy "Astral Plate" ilvl 86 influence warlord for price "base:astral_plate_warlord_86"
    repeat {
        # make sure the only suffix is the mana-cost mod BEFORE paying for Dominance
        repeat { alt_regal_two_mods("Warlord: mana cost") } until suffix_count == 1
        if influenced_count < 2 { beastcraft add_mod warlord }
        dominance_until_elevated("Warlord: mana cost")
    } until has "Warlord: mana cost" elevated and suffix_count == 1 and open_prefix >= 1
    craft lock_suffixes          # bench: the item is rare here
    scour
    set_aside warlord
}

# Step 1 (no preview): any rare whose only influenced mod is the elevated mana mod;
# the Awakener rerolls everything else anyway.
def warlord_piece_lean() {
    buy "Astral Plate" ilvl 86 influence warlord for price "base:astral_plate_warlord_86"
    elevate_warlord("Warlord: mana cost")
    set_aside warlord
}

# Step 2: Hunter piece -> elevated T1 attack crit as its only influenced mod. Set aside as `hunter`.
def hunter_piece() {
    buy "Astral Plate" ilvl 84 influence hunter for price "base:astral_plate_hunter_84"
    elevate_hunter("Hunter: attack crit")
    set_aside hunter
}

# Step 3 with previews: Hinekora's Lock on the magic warlord piece, look at the Awakener
# result, only accept it with a good third suffix AND an open prefix (for the lock).
# UNVERIFIED: a declined preview + a new lock gives a NEW independent preview.
def merge_farm_third_suffix() {
    take warlord
    repeat limit 20 {
        beastcraft hinekoras_lock
        foresee awaken hunter accept if open_prefix >= 1 and (has "fire res" tier <= 2 or has "cold res" tier <= 2 or has "lightning res" tier <= 2
                                    or has "chaos res" tier <= 2 or has "Warlord: all res" tier <= 2) otherwise { }
    } until influenced hunter
    if not influenced hunter {
        # gave up farming: take any result that leaves room for the lock
        repeat limit 20 {
            beastcraft hinekoras_lock
            foresee awaken hunter accept if open_prefix >= 1 otherwise { }
        } until influenced hunter
    }
    if not influenced hunter { awaken hunter }
}

# Step 3 without previews.
def merge_blind() {
    take warlord
    awaken hunter
}

# Step 4: locked Caster reforge. "You can apply an additional Curse" is the only caster-tagged
# PREFIX on a Hunter/Warlord Astral Plate, but the Hunter spell-crit SUFFIX is caster-tagged too,
# and a locked reforge can add mods to the locked side's open slots (owner, 2026-11-18). So the
# curse is only guaranteed when all 3 suffixes are full (with 2 suffixes: ~34%).
# Version 1 (as the owner crafts it): one attempt, whatever happens.
def curse_reforge() {
    if open_prefix == 0 { fail "no open prefix for the Suffixes Cannot Be Changed craft (stuck)" }
    craft lock_suffixes
    harvest reforge caster
}

# Version 2: fill the 3rd suffix first when cheap (one Exalted Orb if 2 prefixes are open), and if
# the curse still missed (the spell-crit suffix took the open suffix slot, so suffixes are now
# full) lock + reforge once more: that attempt is guaranteed while a prefix is open.
def curse_reforge_safe() {
    if open_prefix == 0 { fail "no open prefix for the Suffixes Cannot Be Changed craft (stuck)" }
    if suffix_count == 2 and open_prefix >= 2 { exalt }
    craft lock_suffixes
    harvest reforge caster
    if not has "Hunter: additional curse" and open_prefix >= 1 {
        craft lock_suffixes
        harvest reforge caster
    }
}

# Step 5: fill the open prefixes: 2 open -> Foulborn exalt; then 1 open -> bench armour.
def fill_prefixes() {
    if open_prefix >= 2 { foulborn_exalt }
    if open_prefix >= 1 { craft "bench armour %", "EinharMasterFlatArmour3", "EinharMasterIncreasedLife5_" }
}

# Step 6: six-link + socket colours
def finish() {
    beastcraft max_links
    omen blanching
}
